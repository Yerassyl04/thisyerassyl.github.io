<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ site.baseurl }}/">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% social_links %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-nav-dropdown-toggle="true"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search" aria-label="Open search">
                <span class="nav-link">ctrl k <i class="fa-solid fa-magnifying-glass"></i></span>
              </button>
            </li>
          {% endif %}
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}

          <!-- Toggle language (site-local override; see .al-folio-overrides.yml) -->
          <li class="nav-item" id="lang-toggle-item">
            <button id="lang-toggle" type="button" data-lang="en" title="Change language" aria-label="Change language">
              <span class="nav-link" id="lang-toggle-label">RU</span>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}

  <style>
    /* Explicit, so a theme rule like `div { display: block }` can't defeat [hidden]. */
    #about-en[hidden],
    #about-ru[hidden] {
      display: none;
    }
  </style>

  <script>
    // Site language toggle. Swaps a fixed set of English source strings for the
    // Russian ones in `_data/ru.yml`. Strings absent from the dictionary are left
    // in English, so untranslated pages degrade rather than break.
    (function () {
      var DATA = {{ site.data.ru | jsonify }} || {};
      var DICT = Object.assign({}, DATA.nav || {}, DATA.text || {});
      var STORAGE_KEY = "site-lang";

      // Never rewrite the toggle's own label, and skip the search hint.
      var NAV = "#navbarNav .nav-link:not(#lang-toggle-label), #navbarNav .dropdown-item";
      var TEXT = ".post-title, .post-description, p.desc";

      // Elements may wrap their label in markup (e.g. a `.sr-only` "(current)" span,
      // or an <i> icon). Only the first non-empty text node is read and rewritten,
      // which leaves that markup intact.
      function firstTextNode(el) {
        for (var i = 0; i < el.childNodes.length; i++) {
          var n = el.childNodes[i];
          if (n.nodeType === 3 && n.textContent.trim()) return n;
        }
        return null;
      }
      function readLabel(el) {
        if (el.children.length === 0) return el.textContent.trim();
        var n = firstTextNode(el);
        return n ? n.textContent.trim() : "";
      }
      function writeLabel(el, value) {
        if (el.children.length === 0) {
          el.textContent = value;
          return;
        }
        var n = firstTextNode(el);
        if (!n) return;
        // Keep the node's surrounding whitespace, so the gap before a trailing
        // `.sr-only` span (read aloud as "about (current)") survives a swap.
        n.textContent = n.textContent.match(/^\s*/)[0] + value + n.textContent.match(/\s*$/)[0];
      }

      function apply(lang) {
        var toRu = lang === "ru";

        document.querySelectorAll(NAV + ", " + TEXT).forEach(function (el) {
          // Cache the English source on first pass; it is the dictionary key.
          if (el.dataset.i18nEn === undefined) el.dataset.i18nEn = readLabel(el);
          var en = el.dataset.i18nEn;
          // Leave untranslated elements strictly untouched — rewriting them would
          // trim surrounding whitespace (e.g. the space before the search icon).
          if (!en || !DICT[en]) return;
          writeLabel(el, toRu ? DICT[en] : en);
        });

        // The about page ships both language bodies as sibling divs.
        var aboutEn = document.getElementById("about-en");
        var aboutRu = document.getElementById("about-ru");
        if (aboutEn && aboutRu) {
          aboutEn.hidden = toRu;
          aboutRu.hidden = !toRu;
        }

        var btn = document.getElementById("lang-toggle");
        var label = document.getElementById("lang-toggle-label");
        if (btn) btn.dataset.lang = lang;
        if (label) label.textContent = toRu ? "EN" : "RU";
        document.documentElement.lang = lang;
      }

      function saved() {
        try {
          return localStorage.getItem(STORAGE_KEY);
        } catch (e) {
          return null; // storage unavailable (private mode) — toggle still works per-visit
        }
      }

      function init() {
        var btn = document.getElementById("lang-toggle");
        if (btn) {
          btn.addEventListener("click", function () {
            var next = btn.dataset.lang === "ru" ? "en" : "ru";
            apply(next);
            try {
              localStorage.setItem(STORAGE_KEY, next);
            } catch (e) {
              /* ignore */
            }
          });
        }
        if (saved() === "ru") apply("ru");
      }

      // `.post-title` etc. appear after this include, so wait for the full document.
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
      } else {
        init();
      }
    })();
  </script>
</header>
